rule prokka:
    input:
        assembly="results/{sample}/shovill/contigs.fa"
    output:
        prokka="results/{sample}/prokka/{sample}.gff",
        err="results/{sample}/prokka/{sample}.err",
        faa="results/{sample}/prokka/{sample}.faa",
        ffn="results/{sample}/prokka/{sample}.ffn",
        fna="results/{sample}/prokka/{sample}.fna",
        fsa="results/{sample}/prokka/{sample}.fsa",
        gbk="results/{sample}/prokka/{sample}.gbk",
        log="results/{sample}/prokka/{sample}.log",
        sqn="results/{sample}/prokka/{sample}.sqn",
        tbl="results/{sample}/prokka/{sample}.tbl",
        tsv="results/{sample}/prokka/{sample}.tsv",
        txt="results/{sample}/prokka/{sample}.txt"
    threads:
        prokka_cpus
    conda:
        "envs/prokka_env.yml"
    shell:
        r"""
        set -euo pipefail
        if [[ ! -s {input.assembly} ]] || ! grep -q '^>' {input.assembly}; then
            mkdir -p results/{wildcards.sample}/prokka results/{wildcards.sample}/status
            echo "Prokka skipped for {wildcards.sample}: valid assembly not found." > results/{wildcards.sample}/status/prokka.skipped.txt
            :> {output.prokka}
            :> {output.err}
            :> {output.faa}
            :> {output.ffn}
            :> {output.fna}
            :> {output.fsa}
            :> {output.gbk}
            :> {output.sqn}
            :> {output.tbl}
            :> {output.tsv}
            :> {output.txt}
            :> {output.log}
            exit 0
        fi
        if ! prokka --centre X --compliant {input.assembly} \
            --outdir results/{wildcards.sample}/prokka/ \
            --force --cpus {threads} \
            --prefix {wildcards.sample}; then
            echo -e "\n[ERROR] Prokka failed for sample {wildcards.sample}. Check {output.log} for details." >&2
            mkdir -p results/{wildcards.sample}/prokka results/{wildcards.sample}/status
            echo "Prokka failed for sample {wildcards.sample}. Check {output.log} for details." > results/{wildcards.sample}/status/prokka.failed.txt
            if [[ ! -f {output.log} ]]; then
                :> {output.log}
            fi
            if [[ "{failure_policy}" == "warn" ]]; then
                :> {output.prokka}
                :> {output.err}
                :> {output.faa}
                :> {output.ffn}
                :> {output.fna}
                :> {output.fsa}
                :> {output.gbk}
                :> {output.sqn}
                :> {output.tbl}
                :> {output.tsv}
                :> {output.txt}
            else
                exit 1
            fi
        fi
        """

rule quast:
    input:
        assembly="results/{sample}/shovill/contigs.fa"
    output:
        report="results/{sample}/quast/report.tsv"
    threads:
        quast_cpus
    conda:
        "envs/quast_env.yml"
    shell:
        r"""
        set -uo pipefail
        mkdir -p results/{wildcards.sample}/quast results/{wildcards.sample}/status
        if [[ ! -s {input.assembly} ]] || ! grep -q '^>' {input.assembly}; then
            echo "QUAST skipped for {wildcards.sample}: valid assembly not found." > results/{wildcards.sample}/status/quast.skipped.txt
            :> {output.report}
            exit 0
        fi
        if ! quast.py {input.assembly} -o results/{wildcards.sample}/quast --threads {threads}; then
            echo "QUAST failed for {wildcards.sample}." > results/{wildcards.sample}/status/quast.failed.txt
            if [[ "{failure_policy}" == "warn" ]]; then
                :> {output.report}
            else
                exit 1
            fi
        fi
        """

rule checkm2_database:
    output:
        marker="checkm2/database_path.txt"
    conda:
        "envs/checkm2_env.yml"
    shell:
        r"""
        set -uo pipefail
        mkdir -p checkm2
        DB_DIR="${{CHECKM2_DB_DIR:-$HOME/.pegas/checkm2_db}}"
        if [[ -n "${{CHECKM2DB:-}}" && -f "${{CHECKM2DB}}" ]]; then
            echo "${{CHECKM2DB}}" > {output.marker}
            exit 0
        fi
        FOUND="$(find "$DB_DIR" -name '*.dmnd' 2>/dev/null | head -n1 || true)"
        if [[ -n "$FOUND" ]]; then
            echo "$FOUND" > {output.marker}
            exit 0
        fi
        mkdir -p "$DB_DIR"
        echo "[pegas] Downloading CheckM2 database (~3 GB, one-time) ..." >&2
        if checkm2 database --download --path "$DB_DIR"; then
            FOUND="$(find "$DB_DIR" -name '*.dmnd' 2>/dev/null | head -n1 || true)"
            if [[ -n "$FOUND" ]]; then
                echo "$FOUND" > {output.marker}
                exit 0
            fi
        fi
        echo "[pegas] Warning: CheckM2 database unavailable; CheckM2 will be skipped." >&2
        :> {output.marker}
        exit 0
        """

rule checkm2:
    input:
        assembly="results/{sample}/shovill/contigs.fa",
        db="checkm2/database_path.txt"
    output:
        report="results/{sample}/checkm2/quality_report.tsv"
    threads:
        checkm2_cpus
    conda:
        "envs/checkm2_env.yml"
    shell:
        r"""
        set -uo pipefail
        mkdir -p results/{wildcards.sample}/checkm2 results/{wildcards.sample}/status
        if [[ ! -s {input.assembly} ]] || ! grep -q '^>' {input.assembly}; then
            echo "CheckM2 skipped for {wildcards.sample}: valid assembly not found." > results/{wildcards.sample}/status/checkm2.skipped.txt
            :> {output.report}
            exit 0
        fi
        DB_PATH="$(cat {input.db} 2>/dev/null || true)"
        if [[ -z "$DB_PATH" || ! -f "$DB_PATH" ]]; then
            echo "CheckM2 skipped for {wildcards.sample}: reference database unavailable." > results/{wildcards.sample}/status/checkm2.skipped.txt
            :> {output.report}
            exit 0
        fi
        if ! checkm2 predict --input {input.assembly} \
                --output-directory results/{wildcards.sample}/checkm2 \
                --threads {threads} --database_path "$DB_PATH" --force; then
            echo "CheckM2 failed for {wildcards.sample}." > results/{wildcards.sample}/status/checkm2.failed.txt
            if [[ "{failure_policy}" == "warn" ]]; then
                :> {output.report}
            else
                exit 1
            fi
        fi
        """

rule abricate_database_versions:
    output:
        db_versions="dataframe/database_versions.tsv"
    conda:
        "envs/abricate_env.yml"
    shell:
        r"""
        mkdir -p dataframe
        if ! abricate --list > {output.db_versions}; then
            printf 'DATABASE\tSTATUS\tMESSAGE\nabricate\tunavailable\tabricate --list failed\n' > {output.db_versions}
        fi
        """

checkpoint build_dataframe:
    input:
        html=expand("fastqc/{file}_fastqc.html", file=file_names),
        html_zip=expand("fastqc/{file}_fastqc.zip", file=file_names),
        abricate_ncbi=expand("results/{sample}/abricate_ncbi.tsv", sample=sample_names),
        abricate_plasmidfinder=expand("results/{sample}/abricate_plasmidfinder.tsv", sample=sample_names),
        abricate_vfdb=expand("results/{sample}/abricate_vfdb.tsv", sample=sample_names),
        mlst=expand("results/{sample}/mlst.tsv", sample=sample_names),
        shovill=expand("results/{sample}/shovill/contigs.fa", sample=sample_names),
        prokka=expand("results/{sample}/prokka/{sample}.gff", sample=sample_names),
        quast=expand("results/{sample}/quast/report.tsv", sample=sample_names),
        checkm2=expand("results/{sample}/checkm2/quality_report.tsv", sample=sample_names),
        db_versions="dataframe/database_versions.tsv"
    output:
        dataframe="dataframe/results.csv",
        status="dataframe/sample_status.tsv"
    run:
        build_dataframe()

def get_pangenome_prokka_outputs(wildcards):
    # Get the output of the build_dataframe checkpoint
    df_output = checkpoints.build_dataframe.get().output[0]
    df = pd.read_csv(df_output, dtype={'SAMPLE': str})
    
    # Get species with more than one sample
    df_grouped = df.groupby('SPECIES')['SAMPLE'].nunique().reset_index()
    eligible_species = df_grouped.loc[df_grouped['SAMPLE'] > 1, 'SPECIES'].tolist()
    
    # Get the list of Prokka outputs needed
    prokka_files = []
    for species in eligible_species:
        samples = df.loc[df['SPECIES'] == species, 'SAMPLE'].unique()
        for sample in samples:
            prokka_files.append(f"results/{sample}/prokka/{sample}.gff")
    return prokka_files

checkpoint pangenome:
    input:
        dataframe="dataframe/results.csv",
        prokka_outputs=get_pangenome_prokka_outputs
    output:
        pangenome_dir=directory("pangenome")
    threads:
        roary_cpus
    conda:
        "envs/roary_env.yml"
    script:
        "run_roary.py"

def get_pangenome_outputs(wildcards):
    df_output = checkpoints.build_dataframe.get().output[0]
    df = pd.read_csv(df_output, dtype={'SAMPLE': str})
    df_grouped = df.groupby('SPECIES')['SAMPLE'].nunique().reset_index()
    eligible_species = df_grouped.loc[df_grouped['SAMPLE'] > 1, 'SPECIES'].tolist()
    checkpoints.pangenome.get().output[0]
    outputs = []
    for sp in eligible_species:
        gene_presence = f"pangenome/{sp}/output/gene_presence_absence.csv"
        summary_stats = f"pangenome/{sp}/output/summary_statistics.txt"
        if os.path.exists(gene_presence) and os.path.exists(summary_stats):
            outputs.append(gene_presence)
            outputs.append(summary_stats)
    return outputs

rule build_report:
    input:
        pangenome_outputs=get_pangenome_outputs,
    output:
        report="report/report.html"
    run:
        from pegas.build_report import build_report
        build_report(html_path, raw_data_path, work_directory)

rule build_r_report:
    input:
        dataframe="dataframe/results.csv",
        status="dataframe/sample_status.tsv",
        db_versions="dataframe/database_versions.tsv",
        rmd_template=rmd_template_path,
        render_script=r_render_script_path
    output:
        html="report/report_r.html"
    params:
        data_dir=raw_data_path,
        output_dir=work_directory,
        report_html="report/report.html" if interactive_report else "",
        pegas_version=pegas_version,
        pegas_install_dir=install_path
    conda:
        "envs/report_r_env.yml"
    shell:
        r"""
        Rscript "{input.render_script}" \
            --rmd "{input.rmd_template}" \
            --output "{output.html}" \
            --dataframe_csv "{input.dataframe}" \
            --report_html "{params.report_html}" \
            --data_dir "{params.data_dir}" \
            --output_dir "{params.output_dir}" \
            --pegas_version "{params.pegas_version}" \
            --pegas_install_dir "{params.pegas_install_dir}"
        """
