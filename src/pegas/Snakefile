import os
import json
import sys
import warnings

warnings.filterwarnings("ignore", category=DeprecationWarning)
warnings.filterwarnings("ignore", category=FutureWarning)

# Load configuration variables
raw_data_path = config.get("raw_data", "raw_data")
sample_manifest_path = config.get("sample_manifest", None)
install_path = config.get("install_path", None) or os.path.dirname(os.path.realpath(__file__))
shovill_cpus = config.get("shovill_cpu_cores", 1)
shovill_ram = config.get("shovill_ram", None)
shovill_ram_flag = f"--ram {shovill_ram}" if shovill_ram else ""
prokka_cpus = config.get("prokka_cpu_cores", 1)
amrfinder_cpus = config.get("amrfinder_cpu_cores", 1)
quast_cpus = config.get("quast_cpu_cores", 1)
checkm2_cpus = config.get("checkm2_cpu_cores", 1)
roary_cpus = config.get("roary_cpu_cores", 1)
work_directory = config.get("output_dir", None)


def config_flag(*keys, default):
    value = next((config[k] for k in keys if k in config), default)
    return value.lower() in ("1", "true", "yes", "y") if isinstance(value, str) else bool(value)


simple_report = config_flag("simple_report", "r_report", default=True)
interactive_report = config_flag("interactive_report", "html_report", default=False)
failure_policy = str(config.get("on_tool_failure", "stop")).lower()
if failure_policy not in ("stop", "warn"):
    failure_policy = "stop"

html_path = f"{install_path}"
rmd_template_path = os.path.join(install_path, "report_template.Rmd")
r_render_script_path = os.path.join(install_path, "render_report.R")
r_report_outputs = ["report/report_r.html"] if simple_report else []
html_report_outputs = ["report/report.html"] if interactive_report else []

try:
    import importlib.metadata as metadata
    pegas_version = metadata.version("pegas")
except Exception:
    pegas_version = "unknown"

package_root = os.path.dirname(install_path)
if package_root not in sys.path:
    sys.path.insert(0, package_root)

from pegas.build_dataframe import build_dataframe
from pegas.common import list_fastq_files, build_fastq_pairs, fastq_id, amrfinder_organism, pangenome_groups

# ================= Data Preparation =================

if sample_manifest_path and os.path.exists(sample_manifest_path):
    with open(sample_manifest_path, "r") as f:
        sample_pairs = json.load(f).get("sample_pairs", {})
else:
    sample_pairs = build_fastq_pairs(list_fastq_files(raw_data_path))

sample_names = sorted(sample_pairs)
ABRICATE_DBS = ["plasmidfinder", "vfdb"]
fastq_lookup = {fastq_id(f): f for reads in sample_pairs.values() for f in reads.values()}
file_names = sorted(fastq_lookup)

# Bash helpers prepended to the per-sample tool rules. With --on-tool-failure warn,
# a failing tool records a status marker and leaves empty outputs so the run continues.
SHELL_HELPERS = r"""
# GNU parallel (used by prokka) aborts its jobs when no shell is exported.
export SHELL="${SHELL:-/bin/bash}" PARALLEL_SHELL="${PARALLEL_SHELL:-${SHELL:-/bin/bash}}"
mark() {  # mark <sample> <stage> <skipped|failed> <message>
    mkdir -p "results/$1/status"; echo "$4" > "results/$1/status/$2.$3.txt"
}
has_assembly() { [[ -s "$1" ]] && grep -q '^>' "$1"; }
empty_outputs() {  # truncate outputs, but keep existing logs
    local f
    for f in "$@"; do
        mkdir -p "$(dirname "$f")"
        if [[ "$f" == *.log && -e "$f" ]]; then continue; fi
        : > "$f"
    done
}
skip() {  # skip <sample> <stage> <outputs...>
    mark "$1" "$2" skipped "$2 skipped for $1: valid assembly not found."
    shift 2; empty_outputs "$@"
}
begin() {  # begin <sample> <stage>: forget status markers from earlier attempts
    rm -f "results/$1/status/$2".*.txt
}
fail() {  # fail <sample> <stage> <outputs...>
    mark "$1" "$2" failed "$2 failed for $1 (see logs/$2/$1.log)"
    echo "[pegas] $2 failed for $1" >&2
    if [[ "FAILURE_POLICY" != warn ]]; then exit 1; fi
    shift 2; empty_outputs "$@"
}
""".replace("FAILURE_POLICY", failure_policy)

# ================= Snakemake Workflow =================

def get_pangenome_prokka_outputs(wildcards):
    df_output = checkpoints.build_dataframe.get().output.dataframe
    return [f"results/{s}/prokka/{s}.gff" for samples in pangenome_groups(df_output).values() for s in samples]


def get_pangenome_outputs(wildcards):
    groups = pangenome_groups(checkpoints.build_dataframe.get().output.dataframe)
    checkpoints.pangenome.get()
    outputs = []
    for sp in groups:
        files = [f"pangenome/{sp}/output/gene_presence_absence.csv", f"pangenome/{sp}/output/summary_statistics.txt"]
        if all(os.path.exists(f) for f in files):
            outputs.extend(files)
    return outputs


rule all:
    input:
        expand("fastqc/{file}_fastqc.html", file=file_names),
        expand("results/{sample}/amrfinder.tsv", sample=sample_names),
        expand("results/{sample}/abricate_{db}.tsv", sample=sample_names, db=ABRICATE_DBS),
        expand("results/{sample}/prokka/{sample}.gff", sample=sample_names),
        "dataframe/results.csv",
        get_pangenome_outputs,
        html_report_outputs,
        r_report_outputs

rule fastqc:
    input:
        fastq_files=lambda wildcards: fastq_lookup[wildcards.file]
    output:
        html="fastqc/{file}_fastqc.html",
        html_zip="fastqc/{file}_fastqc.zip",
    log:
        "logs/fastqc/{file}.log"
    benchmark:
        "benchmarks/fastqc/{file}.tsv"
    conda:
        "envs/fastqc_env.yml"
    shell:
        """
        mkdir -p fastqc
        fastqc {input.fastq_files} -o fastqc > {log} 2>&1
        """

rule shovill:
    input:
        R1=lambda wildcards: sample_pairs[wildcards.sample]["R1"],
        R2=lambda wildcards: sample_pairs[wildcards.sample]["R2"]
    output:
        assembly="results/{sample}/shovill/contigs.fa",
        gfa="results/{sample}/shovill/contigs.gfa",
        corrections="results/{sample}/shovill/shovill.corrections",
        log="results/{sample}/shovill/shovill.log",
        spades="results/{sample}/shovill/spades.fasta"
    log:
        "logs/shovill/{sample}.log"
    benchmark:
        "benchmarks/shovill/{sample}.tsv"
    threads:
        shovill_cpus
    resources:
        mem_gb=shovill_ram if shovill_ram else 0
    conda:
        "envs/shovill_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec > {log} 2>&1
        begin {wildcards.sample} {rule}
        shovill --trim --outdir results/{wildcards.sample}/shovill \
            --R1 {input.R1} --R2 {input.R2} \
            --force --cpus {threads} {shovill_ram_flag} \
            || fail {wildcards.sample} shovill {output}
        """

rule mlst:
    input:
        assembly="results/{sample}/shovill/contigs.fa"
    output:
        mlst="results/{sample}/mlst.tsv"
    log:
        "logs/mlst/{sample}.log"
    benchmark:
        "benchmarks/mlst/{sample}.tsv"
    conda:
        "envs/mlst_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec 2> {log}
        begin {wildcards.sample} {rule}
        has_assembly {input.assembly} || {{ skip {wildcards.sample} mlst {output}; exit 0; }}
        mlst {input.assembly} > {output.mlst} || fail {wildcards.sample} mlst {output}
        """

rule amrfinder_database:
    output:
        marker="amrfinder/database_path.txt"
    log:
        "logs/amrfinder_database.log"
    conda:
        "envs/amrfinder_env.yml"
    shell:
        r"""
        exec > {log} 2>&1
        DB_DIR="${{AMRFINDER_DB_DIR:-$HOME/.pegas/amrfinder_db}}"
        if [[ ! -f "$DB_DIR/latest/version.txt" ]]; then
            echo "[pegas] Downloading AMRFinderPlus database (one-time) ..." >&2
            amrfinder_update --database "$DB_DIR" || true
        fi
        if [[ -f "$DB_DIR/latest/version.txt" ]]; then
            echo "$DB_DIR/latest" > {output.marker}
        else
            echo "[pegas] AMRFinderPlus database unavailable." >&2
            [[ "{failure_policy}" == warn ]] || exit 1
            : > {output.marker}
        fi
        """

localrules: amrfinder_organism

# AMRFinderPlus --organism (enables point mutations) derived from the MLST species.
rule amrfinder_organism:
    input:
        mlst="results/{sample}/mlst.tsv"
    output:
        organism="results/{sample}/amrfinder_organism.txt"
    run:
        with open(output.organism, "w") as fh:
            fh.write(amrfinder_organism(input.mlst) or "")

rule amrfinder:
    input:
        assembly="results/{sample}/shovill/contigs.fa",
        organism="results/{sample}/amrfinder_organism.txt",
        db="amrfinder/database_path.txt"
    output:
        amrfinder="results/{sample}/amrfinder.tsv"
    log:
        "logs/amrfinder/{sample}.log"
    benchmark:
        "benchmarks/amrfinder/{sample}.tsv"
    threads:
        amrfinder_cpus
    conda:
        "envs/amrfinder_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec > {log} 2>&1
        begin {wildcards.sample} {rule}
        has_assembly {input.assembly} || {{ skip {wildcards.sample} amrfinder {output}; exit 0; }}
        DB="$(cat {input.db})"
        [[ -n "$DB" ]] || {{ fail {wildcards.sample} amrfinder {output}; exit 0; }}
        ORG="$(cat {input.organism})"
        amrfinder -n {input.assembly} --plus ${{ORG:+--organism "$ORG"}} --threads {threads} \
            --database "$DB" -o {output.amrfinder} || fail {wildcards.sample} amrfinder {output}
        """

rule abricate:
    input:
        assembly="results/{sample}/shovill/contigs.fa"
    output:
        abricate="results/{sample}/abricate_{db}.tsv"
    wildcard_constraints:
        db="|".join(ABRICATE_DBS)
    log:
        "logs/abricate_{db}/{sample}.log"
    benchmark:
        "benchmarks/abricate_{db}/{sample}.tsv"
    conda:
        "envs/abricate_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec 2> {log}
        STAGE=abricate_{wildcards.db}
        begin {wildcards.sample} $STAGE
        has_assembly {input.assembly} || {{ skip {wildcards.sample} $STAGE {output}; exit 0; }}
        abricate --db {wildcards.db} {input.assembly} > {output.abricate} \
            || fail {wildcards.sample} $STAGE {output}
        """

rule prokka:
    input:
        assembly="results/{sample}/shovill/contigs.fa"
    output:
        prokka="results/{sample}/prokka/{sample}.gff",
        err="results/{sample}/prokka/{sample}.err",
        faa="results/{sample}/prokka/{sample}.faa",
        ffn="results/{sample}/prokka/{sample}.ffn",
        fna="results/{sample}/prokka/{sample}.fna",
        fsa="results/{sample}/prokka/{sample}.fsa",
        gbk="results/{sample}/prokka/{sample}.gbk",
        log="results/{sample}/prokka/{sample}.log",
        sqn="results/{sample}/prokka/{sample}.sqn",
        tbl="results/{sample}/prokka/{sample}.tbl",
        tsv="results/{sample}/prokka/{sample}.tsv",
        txt="results/{sample}/prokka/{sample}.txt"
    log:
        "logs/prokka/{sample}.log"
    benchmark:
        "benchmarks/prokka/{sample}.tsv"
    threads:
        prokka_cpus
    conda:
        "envs/prokka_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec > {log} 2>&1
        begin {wildcards.sample} {rule}
        has_assembly {input.assembly} || {{ skip {wildcards.sample} prokka {output}; exit 0; }}
        prokka --centre X --compliant {input.assembly} \
            --outdir results/{wildcards.sample}/prokka/ \
            --force --cpus {threads} --prefix {wildcards.sample} \
            || fail {wildcards.sample} prokka {output}
        """

rule quast:
    input:
        assembly="results/{sample}/shovill/contigs.fa"
    output:
        report="results/{sample}/quast/report.tsv"
    log:
        "logs/quast/{sample}.log"
    benchmark:
        "benchmarks/quast/{sample}.tsv"
    threads:
        quast_cpus
    conda:
        "envs/quast_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec > {log} 2>&1
        begin {wildcards.sample} {rule}
        has_assembly {input.assembly} || {{ skip {wildcards.sample} quast {output}; exit 0; }}
        quast.py {input.assembly} -o results/{wildcards.sample}/quast --threads {threads} \
            || fail {wildcards.sample} quast {output}
        """

rule checkm2_database:
    output:
        marker="checkm2/database_path.txt"
    log:
        "logs/checkm2_database.log"
    conda:
        "envs/checkm2_env.yml"
    shell:
        r"""
        exec > {log} 2>&1
        mkdir -p checkm2
        DB_DIR="${{CHECKM2_DB_DIR:-$HOME/.pegas/checkm2_db}}"
        if [[ -n "${{CHECKM2DB:-}}" && -f "${{CHECKM2DB}}" ]]; then
            echo "${{CHECKM2DB}}" > {output.marker}
            exit 0
        fi
        FOUND="$(find "$DB_DIR" -name '*.dmnd' 2>/dev/null | head -n1 || true)"
        if [[ -z "$FOUND" ]]; then
            mkdir -p "$DB_DIR"
            echo "[pegas] Downloading CheckM2 database (~3 GB, one-time) ..." >&2
            checkm2 database --download --path "$DB_DIR" || true
            FOUND="$(find "$DB_DIR" -name '*.dmnd' 2>/dev/null | head -n1 || true)"
        fi
        [[ -n "$FOUND" ]] || echo "[pegas] Warning: CheckM2 database unavailable; CheckM2 will be skipped." >&2
        echo "$FOUND" > {output.marker}
        """

rule checkm2:
    input:
        assembly="results/{sample}/shovill/contigs.fa",
        db="checkm2/database_path.txt"
    output:
        report="results/{sample}/checkm2/quality_report.tsv"
    log:
        "logs/checkm2/{sample}.log"
    benchmark:
        "benchmarks/checkm2/{sample}.tsv"
    threads:
        checkm2_cpus
    conda:
        "envs/checkm2_env.yml"
    shell:
        r"""
        {SHELL_HELPERS}
        exec > {log} 2>&1
        begin {wildcards.sample} {rule}
        has_assembly {input.assembly} || {{ skip {wildcards.sample} checkm2 {output}; exit 0; }}
        DB_PATH="$(cat {input.db} 2>/dev/null || true)"
        if [[ -z "$DB_PATH" || ! -f "$DB_PATH" ]]; then
            mark {wildcards.sample} checkm2 skipped "CheckM2 skipped for {wildcards.sample}: reference database unavailable."
            : > {output.report}
            exit 0
        fi
        checkm2 predict --input {input.assembly} \
            --output-directory results/{wildcards.sample}/checkm2 \
            --threads {threads} --database_path "$DB_PATH" --force \
            || fail {wildcards.sample} checkm2 {output}
        """

rule database_versions:
    input:
        amrfinder_db="amrfinder/database_path.txt"
    output:
        db_versions="dataframe/database_versions.tsv"
    conda:
        "envs/abricate_env.yml"
    shell:
        r"""
        mkdir -p dataframe
        abricate --list 2>/dev/null | awk -F'\t' '$1 == "DATABASE" || $1 == "plasmidfinder" || $1 == "vfdb"' > {output.db_versions} || true
        [[ -s {output.db_versions} ]] || printf 'DATABASE\tSEQUENCES\tDBTYPE\tDATE\nplasmidfinder\t-\t-\tunavailable\n' > {output.db_versions}
        AMR_DB="$(cat {input.amrfinder_db})"
        printf 'amrfinderplus\t-\t-\t%s\n' "$(cat "$AMR_DB/version.txt" 2>/dev/null || echo unavailable)" >> {output.db_versions}
        """

checkpoint build_dataframe:
    input:
        expand("fastqc/{file}_fastqc.html", file=file_names),
        expand("fastqc/{file}_fastqc.zip", file=file_names),
        expand("results/{sample}/shovill/contigs.fa", sample=sample_names),
        expand("results/{sample}/amrfinder.tsv", sample=sample_names),
        expand("results/{sample}/abricate_{db}.tsv", sample=sample_names, db=ABRICATE_DBS),
        expand("results/{sample}/mlst.tsv", sample=sample_names),
        expand("results/{sample}/prokka/{sample}.gff", sample=sample_names),
        expand("results/{sample}/quast/report.tsv", sample=sample_names),
        expand("results/{sample}/checkm2/quality_report.tsv", sample=sample_names),
        "dataframe/database_versions.tsv"
    output:
        dataframe="dataframe/results.csv",
        status="dataframe/sample_status.tsv"
    run:
        build_dataframe()

checkpoint pangenome:
    input:
        dataframe="dataframe/results.csv",
        prokka_outputs=get_pangenome_prokka_outputs
    output:
        pangenome_dir=directory("pangenome")
    params:
        groups=lambda wildcards, input: json.dumps(pangenome_groups(input.dataframe)),
        script=os.path.join(install_path, "run_roary.py")
    log:
        "logs/roary.log"
    threads:
        roary_cpus
    conda:
        "envs/roary_env.yml"
    shell:
        """
        python {params.script} '{params.groups}' {threads} > {log} 2>&1
        """

rule build_report:
    input:
        pangenome_outputs=get_pangenome_outputs,
    output:
        report="report/report.html"
    run:
        from pegas.build_report import build_report
        build_report(html_path, raw_data_path, work_directory)

rule build_r_report:
    input:
        dataframe="dataframe/results.csv",
        status="dataframe/sample_status.tsv",
        db_versions="dataframe/database_versions.tsv",
        pangenome_outputs=get_pangenome_outputs,
        rmd_template=rmd_template_path,
        render_script=r_render_script_path
    output:
        html="report/report_r.html"
    params:
        data_dir=raw_data_path,
        output_dir=work_directory,
        report_html=os.path.join(work_directory or ".", "report/report.html") if interactive_report else "",
        pegas_version=pegas_version,
        pegas_install_dir=install_path
    log:
        "logs/report_r.log"
    conda:
        "envs/report_r_env.yml"
    shell:
        r"""
        Rscript "{input.render_script}" \
            --rmd "{input.rmd_template}" \
            --output "{output.html}" \
            --dataframe_csv "$PWD/{input.dataframe}" \
            --report_html "{params.report_html}" \
            --data_dir "{params.data_dir}" \
            --output_dir "{params.output_dir}" \
            --pegas_version "{params.pegas_version}" \
            --pegas_install_dir "{params.pegas_install_dir}" > {log} 2>&1
        """
